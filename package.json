{
  "name": "botsprig",
  "version": "1.0.0",
  "description": "Official Node.js SDK for the BotSprig BotFlow Platform API",
  "keywords": [
    "botsprig",
    "botflow",
    "telegram",
    "telegram-bot",
    "sdk",
    "api-client",
    "automation",
    "chatbot"
  ],
  "homepage": "https://github.com/botsprig/botsprig-node#readme",
  "bugs": {
    "url": "https://github.com/botsprig/botsprig-node/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/botsprig/botsprig-node.git"
  },
  "license": "MIT",
  "author": "benkhalifedev",
  "type": "commonjs",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:cjs && npm run build:esm && npm run build:types",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:types": "tsc -p tsconfig.types.json",
    "clean": "rm -rf dist",
    "test": "node --test tests/client.test.mjs tests/cjs.test.js",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
